config_version=5

[application]
config/name="NIGHTFALL · Ghost Protocol"
run/main_scene="res://blackwhite.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.045, 1)
