   "src/shell/titleMenu.js"
  ],
  "kind": "literal"
 },
 {
  "key": "No. Not once. She kept the scarf up and her back to the lamp. I remember thinking she was very good at it.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "NOT READ IN 1978 YET",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "NOT YET",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js",
   "src/chapters/nightService/PanelScene.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Nothing official. Seline finished her first paid week at the laundry, Miro found sugar, and nobody has been arrested. We decided that was enough.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "of here — the tall stone front with the recessed doors, where Toma waits.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "of here — the tall stone front with the recessed doors.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "of here, at the south edge of the square — look for the old connector block between the paving grooves.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "of here, beyond the ministry lane.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "of here. Eda sells lamp oil under the blue canvas.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "of here. Follow the rails.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "Oil is bought, and yesterday someone paid for this on seat forty-three. The ministry is northeast, past the fountain. Toma keeps the door.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "OLEK",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Olek carried the two cans for her, the woman in the rose scarf. He is taking the cart through the ward crossing now.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Olek loaded the cans after she paid him. She left first.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "ONE PASSENGER · CLAIM 1978-0412",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "ONE PASSENGER, PRINTED TWICE",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "One punch files them. Decide what the stack is.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "One punch files them. File the stack as:",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "One seat, one claim, two tickets. The archive printed her twice.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "One step ahead. Always one step.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "One ticket read. Now the other, under the 1978 lens.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "OPEN THE ROOM DOOR",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Or cleaned something that was here before. We record the pale area. We do not choose between those explanations yet.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Orchard case.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Order C-441. An unregistered branch under the clock paving was losing pressure, so I cut it.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Paid in cash, stamped SEAT 43.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "PATTERN OK",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "People miss trains, leave spouses, lose papers and sometimes want one quiet night. I have done it for years. She did not invent the arrangement.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "PETAR",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Petar cut the branch. Later, someone placed both ends where a person could reconnect them by hand.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Petar says he left them below the cover. Someone lifted them to the surface later.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "PIN",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Pin the other ticket's 1978 record too.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Pin the other ticket's record beside it.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Pin the paper that explains the name VENN.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Pin the papers that show both tickets are one claim.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "PINNED",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "pinned, the proof is not complete.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "PLATFORM SCANNER",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Possible by hand. Not safe to light while we are standing over it, but deliberately recoverable.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Possibly. The reservation contains no photograph and no identity number. I can prove the name and time, not the passenger.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Print both tickets. (Continue)",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Public hall is open. What business are you bringing inside?",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Punch the stack to file it.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "RADA",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Rada says this is a celebration. It is really an excuse to keep me from going back for another shift.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Read both tickets under the lens first.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Read both under the 1978 lens.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "quasi"
 },
 {
  "key": "READ THE BURNING LETTERS",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "READ THE SECOND ROW",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Record that much. The archive is closing and the next train is tomorrow morning. I booked you a room at the Copper Heron.",
  "files": [
