  ],
  "kind": "literal"
 },
 {
  "key": "It is the least glamorous part of the job.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "It lit on the bell. As if she knew the minute I would kneel here.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "It stays inside the mortar. At every corner it turns with the joint instead of crossing the stone.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "KEEP MOVING. — M.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Keep moving. The night service calls at seven.",
