   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "AS A QUESTION ONLY SHE CAN ANSWER",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "AS A WORRY, NOT A CHARGE",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "AS CENSORSHIP",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "AS FACTS, AND ONE UNKNOWN",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "AS FORCE",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "AS HIS FAULT",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "AS YOUR OWN PROBLEM",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Before dawn she returned the key and asked for no carriage. Nobody walked her out.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "BORROWED LIGHT · LAST NIGHT",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Cases stay aboard. Owners get off. Her city case was collected.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Cash is how this city pays. People want one quiet night. She did not invent the arrangement.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Choice does not guarantee she is still safe. The message is already a day old.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "CHOOSE TWO TRUE THINGS · ONE HE CAN GRANT, ONE THAT STAYS OPEN",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "CLAIM 1978-0412 · THE ORCHARD CASE",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "CLAIM 1978-0412 · TWO CLAIMS",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js",
   "src/trueEndingScript.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Clear of the door.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Eastbound is a direction, not an address. Bellwether has no forwarding address on file.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Eastbound means she has gone home to the orchard.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Eastbound. That is all I can say before this door closes. Station staff keep the fuller record.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "EDA'S STALL · PAID IN CASH",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Every record gives a time. None of them gives a reason.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "HANA · BEFORE DAWN",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "He files a complaint. It says nothing of her. Try the true thing.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "He files a conspiracy. Her message stays unread. Try the true thing.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "He files a missing person. The file has none. Try the true thing.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "He files her as forced. She chose. Try the true thing.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "He files the doubt. She chose to go. Try the true thing.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Her first line burned true: BUTCH, I WAS HERE.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "HER LETTER · BORROWED LIGHT",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Her message was already a day old when I found it.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Her orchard case is still aboard. She never got off.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "I do not know how to stop looking yet. That may be my problem, not hers.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "I need to know why she left. I can accept the answer if I hear it from her.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "I ride on a claim card, not a ticket. The looking is mine.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "LAMP OIL · TWO CANS",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Late is not forged. A ledger says what came through. Not why.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Mara was alive when she prepared this route. She left by choice. Those are facts. Her reason is still unknown.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "NIKA'S TERMINAL · TIMESTAMPS",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "No record says why she left. The claim lists cases, not reasons.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "No. Personal. Mara disappeared. Echo City is the first place anyone saw her afterward.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Nobody leaves before dawn unless someone makes them.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Not in my carriage. Station staff keep their own records.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Official inquiry? Then make it brief. This service is leaving.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Order C-441. A branch losing pressure, cut from below. Petar never saw a message.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "People wait here every day. One woman kept looking east, then left when the replacement service arrived.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "PLATE IV · ROSA'S DRAWING",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Rosa drew her walking home. That is where she is now.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "SEAT 43 · TWO TICKETS",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She bought the lamp oil to set the square alight.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She chose to go. She handed Hana the key herself.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She kept two lives on purpose: a city room, the orchard at weekends.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She left voluntarily, or somebody made it look that way. Either way, someone here remembers the route.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She paid everything in cash. She was hiding from someone.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She was alive and laying the route. She bought the oil herself.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She went on by choice. Her letter says she could not wait.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Someone could have forced her to perform the whole route alone.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Staff keep timetables, not secrets. You have read every record she left.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Stand back, please.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "STATION STAFF · THE FULLER RECORD",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "THE CARRIAGE LEDGER",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The city cut her second line to silence her.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The clearance came late, so the ledger is forged.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "THE COPPER HERON · ROOM SIX",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "THE CUT FEED · BY THE CLOCK",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "THE FIRE LETTERS · FIRST ROW",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "THE ORCHARD CASE · BELLWETHER",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The second line was cut, and its ends were left for a hand to rejoin.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The station staff are hiding the rest of her record.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Transport noticed the code and Maintenance cut the message. That can be municipal censorship.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Two cans, poured along the joints. The letters burned. Nothing else did.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Two tickets 43 were issued. Someone else travels as her.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Two tickets, one seat, one passenger. The terminal printed her twice.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
 {
  "key": "You found me at the station and led me to the first trace. Maybe you already knew where this ended.",
  "files": [
   "src/chapters/finalBoss/echoExchanges.js"
  ],
  "kind": "literal"
 },
