[
 {
  "key": "Sava authorized the search. I can show you timestamps, not conclusions.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Sava keeps the issue records. Every search at that terminal goes out under his stamp.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "SELINE",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She asked where the old public fire letters connected to the street supply. I told her to ask the archive.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She said leave them by the clock paving, at the service joint. She walked ahead the whole way.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She said she would leave another mark where she could. The last one pointed here.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Sleep. I will find you before the first train.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Someone placed it deliberately.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Something blue catches in the cold ashes, under a coat someone left by the fire.",
