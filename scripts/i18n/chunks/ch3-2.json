  ],
  "kind": "literal"
 },
 {
  "key": "The woman in the rose scarf does not turn. She waits at the scanner line, one step ahead.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Then I will not go alone.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "This afternoon's oil line. It was never a spill. It was the first row.",
