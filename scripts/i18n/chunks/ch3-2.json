  ],
  "kind": "literal"
 },
 {
  "key": "Tell me what you can see before I tell you what I think.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "TERMINAL NOTE · NIKA",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Terminals cut long surnames on duplicates. Two letters, then NN for no name on file. My note is with the prints.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Test whether the ends can meet without tools.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Thank you for treating the facts as facts.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "That claim number went through our station reader yesterday. Twice.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "That crossing has a scanner. It flags anyone who crosses alone. Walk beside Olek, in step, and it reads you as one party.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "That is generally how the book works.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "That is the trick of it. Two people in step and the machine counts one party.",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "That stub on your ledger is seat forty-three. Did she stay here?",
  "files": [
   "src/cars/presentCity3d/chapter3OpeningContent.js"
  ],
  "kind": "literal"
 },
 {
  "key": "THE ARCH IS THE OTHER WAY ·",
  "files": [
