[
 {
  "key": "Mara had not. She recorded ten minutes of it by accident.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Mara hated this fountain. She said the pump sounded like a man clearing his throat.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Most were not hiding a conspiracy. They were hiding debts, affairs, or one more person living in the flat than the lease allowed.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "MUSEUM",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "No. I am waiting. Take the old route: the closed cafe, the fountain, the burned letter box, then the first-tram platform. I want you to hear the city before you hear the tape.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Once. Mara complains about the weather. I count the money in the till. You apologize for missing the tram.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "People burned copies here when the municipal office began asking who had spoken to her.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "RECEIVER",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Reply while you walk:",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "She still asked us to meet here.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "That is all. An ordinary morning. The museum wants to file it as evidence from the day she disappeared.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The archive called this obstruction.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The archive can afford simple words. The people living here could not.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The burned letter box is beside the old archive.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The cafe closed six months after Mara disappeared. The owner kept her chipped cup under the counter until the rent went up.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The first-tram platform is south. I will wait at the overlook.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "The pump still sounds the same.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Then the ordinary parts stay with the record.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Three mornings a week. She tipped badly and always returned the cup herself.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Two mentioned her. The rest were ordinary people afraid an investigation would expose their own lives.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "We did have time. We just did not know which parts would later count as evidence.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "We thought we had more time.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Were any letters about Mara?",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Why bring me by this route?",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "Yes. The city repaired everything except the noise.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "You can take it. But do not play only the part useful for finding her. That was not her whole day.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "You do not have to answer. Keep walking; the fountain is east of the square.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "You missed the first tram here. Mara and I waited with you until sunrise because none of us could afford breakfast.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "You remembered the cup.",
  "files": [
   "src/chapters/museum3d/scenes/LevRevisitSequence.js"
  ],
  "kind": "literal"
 },
 {
  "key": "A museum admission ticket, punched once. Claim 1978-0412.",
  "files": [
   "src/chapters/museum3d/scenes/ServiceLobby.js"
  ],
  "kind": "literal"
 },
